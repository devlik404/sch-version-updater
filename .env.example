# SQL Server
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=

# Required for HTTPS clone/push. The file must contain only the Bitbucket
# service-account personal access token and must have mode 0600.
BITBUCKET_API_TOKEN_PATH=/run/secrets/bitbucket_api_token

# Optional automatic repository discovery.
BITBUCKET_PROJECT_URL=https://bitbucket.example/projects/CASHREOPSC
DISCOVERY_INTERVAL=30d

SCHEDULER_INTERVAL_SECONDS=60
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SECONDS=600
RUNNING_STALE_AFTER_SECONDS=1800
GIT_PUSH_RETRIES=3
GIT_USER_NAME=SCH Version Updater
GIT_USER_EMAIL=sch-version-updater@localhost